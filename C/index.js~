let response = [];

function formatDistance(distance) {
  let result; 
  result = distance.split(', ');
  return parseFloat(result[0]).toFixed(2);
}

function formatTime(time){
  let result;
  let datetimeFormat = new Date("2019-01-01T" + time);
  let mins = datetimeFormat.getMinutes();
  let sec = datetimeFormat.getSeconds();
  result = mins + (sec/60);
  return result;
}


app.get('/GeoNode', function (req, res) {
  res.setHeader('Content-Type', 'text/plain');

    if((!req.session.lat1) || (!req.session.lng1)){ // check is do we have both data in session
      req.session.lat1 = req.query.lat;
      req.session.lng1 = req.query.lng;
      res.write('RECIEVED'); // response
      res.end();
    }else{ // we have session so now just combine
      let prev_data = req.session.lat1 + ' ' + req.session.lng1 ; 
      let curr_data = req.query.lat + ' ' + req.query.lng; 
      let tcpRequest = prev_data + ' ' + curr_data; 
      // tcp connection 
      const client = net.createConnection(tcpPort, tcpHost, () => {console.log("Connected to Geo")}); // the tcp port and host
      client.on('error', (err) => { /* handle error */ });
      client.on('connect', () => {
        client.write(tcpRequest); // Send a request
        client.on('data', (data) => { response.push(data.toString().trim())});
        client.on('end', () => {
          let distance = response.join();
          let result = 'The distance from (' + req.session.lat1 +', ' + req.session.lng1 + ') to (' 
                                            + req.query.lat + ', ' + req.query.lng + ') is: ' + formatDistance(distance) + ' km'
          req.session.lat1 = req.query.lat;
          req.session.lng1 = req.query.lng;  
          res.write(result);  
          res.end();
        });
        client.end();        
      });
    }
});



app.get('/Trip', function (req, res) {
  res.setHeader('Content-Type', 'application/json');
  let start = req.query.from;
  let end = req.query.to;
  // handle the params with UTF-8 
  let encoded_start = encodeURIComponent(start);
  let encoded_end = encodeURIComponent(end);

  // creating the request URL
  let requestURL = mapROOTURL + '&from=' + encoded_start + '&to=' + encoded_end + '&unit=k&timeType=1&useTraffic=true';

  http.get(requestURL , (response) => {
  const { statusCode } = response;
  const contentType = response.headers['content-type'];

  let error;
  if (statusCode !== 200) {
    error = new Error('Request Failed.\n' +
                      `Status Code: ${statusCode}`);
  } else if (!/^application\/json/.test(contentType)) {
    error = new Error('Invalid content-type.\n' +
                      `Expected application/json but received ${contentType}`);
  }
  if (error) {
    console.error(error.message);
    response.resume();
    return;
  }

  response.setEncoding('utf8');
  let rawData = '';
  let result = {
    distance : 0,
    time : 0 
  }
  response.on('data', (chunk) => { rawData += chunk; });
  response.on('end', () => {
    try {
      const parsedData = JSON.parse(rawData);
      // get the data we need from the parsed data
      if((parsedData.info.messages).length != 0 ){
        result.distance = 0;
        result.time = 0 ;
      }else{
        result.distance = parsedData.route.distance;
        result.time = formatTime(parsedData.route.formattedTime);
      }
      res.write(JSON.stringify(result));
      res.end();
      
    } catch (e) {
      console.error(e.message);
    }
  });
}).on('error', (e) => {
  console.error(`Got error: ${e.message}`);
});
  
});


